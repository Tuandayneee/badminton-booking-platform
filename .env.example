# BadmintonPro Environment Variables Sample

# Django
SECRET_KEY='change-me-to-a-strong-random-secret-key'
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
USE_SQLITE=False

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:your-db-password@db:5432/badminton_db
DB_HOST=db
DB_NAME=badminton_db
DB_USER=postgres
DB_PASS=your-db-password
DB_PORT=5432

# PostgreSQL Container
POSTGRES_DB=badminton_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# FastAPI Microservice & Security
FASTAPI_PUBLIC_URL=http://localhost:8001
FASTAPI_INTERNAL_URL=http://fastapi:8001
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
INTERNAL_LOCK_SECRET=change-me-internal-hmac-secret

# Support Contact
SUPPORT_PHONE=0900.000.000

# Email
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD='your-app-password'
DEFAULT_FROM_EMAIL='Badminton Pro <noreply@badmintonpro.vn>'

# Google Social Login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional Gemini API Key
GEMINI_API_KEY=
